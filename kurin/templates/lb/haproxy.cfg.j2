# Rendered by kurin (ha.mode = "kurin-lb"). Frontend is the keepalived VIP;
# backends are every control-plane API endpoint. Health check is the
# apiserver /readyz (plain TCP check keeps the LB dependency-free).
global
    log /dev/log local0
    stats socket {{ stats_socket }}
    master-worker

defaults
    mode    tcp
    log     global
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    retries 3

frontend k8s-api
    bind *:6443
    default_backend k8s-api

backend k8s-api
    # Health check probes /readyz over TLS (check-ssl) and trusts the
    # apiserver's self-signed cert (verify none) — but data traffic stays a
    # pure TCP passthrough: client TLS must reach the backend untouched.
    option httpchk GET /readyz
    http-check expect status 200
    default-server inter 5s fall 3 rise 2

    balance roundrobin
{% for b in backends %}
    server {{ b.name }} {{ b.ip }}:6443 check check-ssl verify none
{% endfor %}

listen stats
    bind *:8404
    mode http
    stats enable
    stats uri /haproxy-stats
    stats refresh 5s
