---
source: kurin/tests/plan_snapshots.rs
expression: plan_matrix(&plan)
---
{
  "stages": [
    {
      "ids": [
        "discover/facts@master01",
        "discover/facts@worker01"
      ],
      "stage": "discover",
      "tasks": [
        {
          "describe": "arch=amd64 os=? cpu=0 mem=0MiB",
          "id": "discover/facts@master01"
        },
        {
          "describe": "arch=amd64 os=? cpu=0 mem=0MiB",
          "id": "discover/facts@worker01"
        }
      ]
    },
    {
      "ids": [
        "preflight/master01",
        "preflight/worker01"
      ],
      "stage": "preflight",
      "tasks": [
        {
          "describe": "probe swap / selinux / time-sync / kernel modules",
          "id": "preflight/master01"
        },
        {
          "describe": "probe swap / selinux / time-sync / kernel modules",
          "id": "preflight/worker01"
        }
      ]
    },
    {
      "ids": [
        "artifacts/install@master01",
        "artifacts/install@worker01"
      ],
      "stage": "artifacts",
      "tasks": [
        {
          "describe": "fetch+install pinned binaries (amd64)",
          "id": "artifacts/install@master01"
        },
        {
          "describe": "fetch+install pinned binaries (amd64)",
          "id": "artifacts/install@worker01"
        }
      ]
    },
    {
      "ids": [
        "prepare/os-baseline@master01",
        "prepare/sysctl@master01",
        "prepare/kernel-deps@master01",
        "prepare/kubelet-unit@master01",
        "prepare/os-baseline@worker01",
        "prepare/sysctl@worker01",
        "prepare/kernel-deps@worker01",
        "prepare/kubelet-unit@worker01",
        "prepare/crio-install@master01",
        "prepare/crio-config@master01",
        "prepare/crio-unit@master01",
        "prepare/crio-install@worker01",
        "prepare/crio-config@worker01",
        "prepare/crio-unit@worker01"
      ],
      "stage": "prepare",
      "tasks": [
        {
          "describe": "disable swap / firewalld, SELinux permissive",
          "id": "prepare/os-baseline@master01"
        },
        {
          "describe": "modprobe br_netfilter; persist net.bridge.bridge-nf-call-iptables net.bridge.bridge-nf-call-ip6tables net.ipv4.ip_forward",
          "id": "prepare/sysctl@master01"
        },
        {
          "describe": "ensure conntrack/socat (+recommended ebtables ipset ipvsadm)",
          "id": "prepare/kernel-deps@master01"
        },
        {
          "describe": "render + install /etc/systemd/system/kubelet.service, enable (start deferred to kubeadm)",
          "id": "prepare/kubelet-unit@master01"
        },
        {
          "describe": "disable swap / firewalld, SELinux permissive",
          "id": "prepare/os-baseline@worker01"
        },
        {
          "describe": "modprobe br_netfilter; persist net.bridge.bridge-nf-call-iptables net.bridge.bridge-nf-call-ip6tables net.ipv4.ip_forward",
          "id": "prepare/sysctl@worker01"
        },
        {
          "describe": "ensure conntrack/socat (+recommended ebtables ipset ipvsadm)",
          "id": "prepare/kernel-deps@worker01"
        },
        {
          "describe": "render + install /etc/systemd/system/kubelet.service, enable (start deferred to kubeadm)",
          "id": "prepare/kubelet-unit@worker01"
        },
        {
          "describe": "install crio 1.33.4 static package",
          "id": "prepare/crio-install@master01"
        },
        {
          "describe": "render + install /etc/crio/crio.conf.d/10-kurin.conf",
          "id": "prepare/crio-config@master01"
        },
        {
          "describe": "render + install /etc/systemd/system/crio.service, enable --now",
          "id": "prepare/crio-unit@master01"
        },
        {
          "describe": "install crio 1.33.4 static package",
          "id": "prepare/crio-install@worker01"
        },
        {
          "describe": "render + install /etc/crio/crio.conf.d/10-kurin.conf",
          "id": "prepare/crio-config@worker01"
        },
        {
          "describe": "render + install /etc/systemd/system/crio.service, enable --now",
          "id": "prepare/crio-unit@worker01"
        }
      ]
    },
    {
      "ids": [],
      "stage": "registry",
      "tasks": []
    },
    {
      "ids": [
        "images/import@master01",
        "images/import@worker01"
      ],
      "stage": "images",
      "tasks": [
        {
          "describe": "no-op online (kubelet pulls from registries)",
          "id": "images/import@master01"
        },
        {
          "describe": "no-op online (kubelet pulls from registries)",
          "id": "images/import@worker01"
        }
      ]
    },
    {
      "ids": [
        "bootstrap/kubeadm-init@master01"
      ],
      "stage": "vip",
      "tasks": [
        {
          "describe": "kubeadm init --config /etc/kurin/kubeadm-init.yaml on master01",
          "id": "bootstrap/kubeadm-init@master01"
        }
      ]
    },
    {
      "ids": [
        "bootstrap/api-ready@master01"
      ],
      "stage": "bootstrap",
      "tasks": [
        {
          "describe": "wait until 192.168.10.11:6443 serves the API (VIP backend up)",
          "id": "bootstrap/api-ready@master01"
        }
      ]
    },
    {
      "ids": [
        "join/kubeadm@worker01"
      ],
      "stage": "api-ready",
      "tasks": [
        {
          "describe": "kubeadm join (worker) -> 192.168.10.11:6443",
          "id": "join/kubeadm@worker01"
        }
      ]
    },
    {
      "ids": [],
      "stage": "join",
      "tasks": []
    },
    {
      "ids": [
        "cni/calico-operator@master01"
      ],
      "stage": "cni",
      "tasks": [
        {
          "describe": "kubectl apply tigera-operator manifest + Installation CR",
          "id": "cni/calico-operator@master01"
        }
      ]
    },
    {
      "ids": [
        "post/kubeconfig@master01",
        "post/state-record@master01"
      ],
      "stage": "post",
      "tasks": [
        {
          "describe": "fetch admin.conf -> merge local kubeconfig (context cluster-crio)",
          "id": "post/kubeconfig@master01"
        },
        {
          "describe": "record cluster state in kube-system/kurin-state",
          "id": "post/state-record@master01"
        }
      ]
    }
  ]
}
