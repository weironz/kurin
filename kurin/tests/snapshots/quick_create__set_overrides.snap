---
source: kurin/tests/quick_create.rs
expression: config.document
---
version = "v1alpha2"
name = "sets"

[network]
pod-cidr = "10.244.0.0/16"

[network.cni]
kind = "flannel"

[ssh.auth]
method = "password"
password = { env = "KURIN_SSH_PASSWORD" }

[nodes.cp-1]
address = "10.9.0.1"
role = "control-plane"

[kubernetes]
version = "1.34.0"
