---
source: kurin/tests/quick_create.rs
expression: config.document
---
version = "v1alpha2"
name = "byname"

[ssh.auth]
method = "password"
password = { env = "KURIN_SSH_PASSWORD" }

[nodes.192-168-10-11]
address = "192.168.10.11"
role = "control-plane"

[nodes.192-168-10-21]
address = "192.168.10.21"
role = "worker"
