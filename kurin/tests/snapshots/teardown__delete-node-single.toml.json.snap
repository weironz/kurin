    "cleanup/stop-services@worker01 -> cleanup/cni-cleanup@worker01",
    "cleanup/cni-cleanup@worker01 -> cleanup/iptables-cleanup@worker01"
  ],
  "op": "DeleteNode",
  "phases": [
    {
      "phase": "drain",
      "tasks": [
        {
          "describe": "drain worker01 from the cluster (via master01)",
          "id": "drain/drain@worker01",
          "node": "master01",
          "policy": "BestEffort"
        },
        {
          "describe": "delete node object worker01 (via master01)",
          "id": "drain/delete-node-object@worker01",
          "node": "master01",
          "policy": "BestEffort"
        }
      ]
    },
    {
      "phase": "reset",
      "tasks": [
        {
          "describe": "kubeadm reset -f",
          "id": "reset/kubeadm-reset@worker01",
          "node": "worker01",
          "policy": "BestEffort"
        }
      ]
    },
    {
      "phase": "cleanup",
      "tasks": [
        {
          "describe": "stop kubelet, containerd",
          "id": "cleanup/stop-services@worker01",
          "node": "worker01",
          "policy": "BestEffort"
        },
        {
          "describe": "remove 22 kurin/distribution paths",
          "id": "cleanup/wipe-dirs@worker01",
          "node": "worker01",
          "policy": "BestEffort"
        },
        {
          "describe": "remove CNI devices and the 10.233.64.0/18 route",
          "id": "cleanup/cni-cleanup@worker01",
          "node": "worker01",
          "policy": "BestEffort"
        },
        {
          "describe": "remove kube-proxy/CNI iptables chains",
          "id": "cleanup/iptables-cleanup@worker01",
          "node": "worker01",
          "policy": "BestEffort"
        }
      ]
    }
  ]
