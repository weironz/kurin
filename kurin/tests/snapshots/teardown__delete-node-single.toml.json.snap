{
  "edges": [
    "drain/drain@worker01 -> reset/kubeadm-reset@worker01",
    "drain/delete-node-object@worker01 -> reset/kubeadm-reset@worker01",
    "reset/kubeadm-reset@worker01 -> cleanup/stop-services@worker01",
    "reset/kubeadm-reset@worker01 -> cleanup/wipe-dirs@worker01",
