# Rendered by kurin (ha.mode = "kurin-lb"). One VRRP instance; the first
# declared LB node is MASTER (highest priority). Unicast peers avoid
# multicast requirements on cloud networks.
global_defs {
    enable_script_security
}

vrrp_instance KURIN_K8S_API {
    state {{ "MASTER" if priority >= 200 else "BACKUP" }}
    interface {{ iface }}
    virtual_router_id 51
    priority {{ priority }}
    advert_int 1
    unicast_src_ip {{ peers[0] if peers else "0.0.0.0" }}
{% if peers and peers|length > 1 %}    unicast_peer {
{% for p in peers %}{% if not loop.first %}        {{ p }}
{% endif %}{% endfor %}    }
{% endif %}
    virtual_ipaddress {
        {{ vip }}/32
    }
}
