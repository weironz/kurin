---
source: crates/kurin-artifact/src/os.rs
expression: script
---
set -eu
dnf install -y -q dnf-plugins-core createrepo_c
dnf --setopt=install_weak_deps=False download --resolve --alldeps \
--destdir /work/repo conntrack-tools socat iptables-nft ipset ipvsadm haproxy keepalived nfs-utils
createrepo_c /work/repo
