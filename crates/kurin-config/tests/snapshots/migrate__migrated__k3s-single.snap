---
source: crates/kurin-config/tests/migrate.rs
expression: snapshot
---
# WP-00 baseline fixture: k3s distribution — one server, one agent, kube-vip
# not applicable (single server), embedded flannel CNI.
version = "v1alpha2"
name = "k3s-single"

[kubernetes]
version = "1.33.1"
distribution = "k3s"

[network]
pod-cidr = "10.233.64.0/18"
service-cidr = "10.233.0.0/18"
dns-domain = "cluster.local"

[network.cni]
kind = "flannel"

[ssh]
user = "root"
port = 22

[ssh.auth]
method = "private_key"
key-path = "/root/.ssh/id_ed25519"

[nodes.server01]
address = "192.168.10.11"
role = "control-plane"

[nodes.agent01]
address = "192.168.10.21"
role = "worker"
