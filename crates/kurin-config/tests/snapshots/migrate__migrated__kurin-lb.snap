---
source: crates/kurin-config/tests/migrate.rs
expression: snapshot
---
# WP-00 baseline fixture: kurin-managed HA — haproxy + keepalived on a
# dedicated `role = "lb"` node fronting two control-plane nodes.
version = "v1alpha2"
name = "kurin-lb"

[kubernetes]
version = "1.33.1"

[network]
pod-cidr = "10.233.64.0/18"
service-cidr = "10.233.0.0/18"
dns-domain = "cluster.local"

[network.cni]
kind = "calico"

[ssh]
user = "root"
port = 22

[ssh.auth]
method = "private_key"
key-path = "/root/.ssh/id_ed25519"

[ha]
mode = "kurin-lb"
vip = "192.168.10.100"

[nodes.cp01]
address = "192.168.10.11"
role = "control-plane"

[nodes.cp02]
address = "192.168.10.12"
role = "control-plane"

[nodes.lb01]
address = "192.168.10.31"
role = "lb"

[nodes.worker01]
address = "192.168.10.21"
role = "worker"
