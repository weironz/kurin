{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ingress-nginx values",
  "description": "ingress-nginx 常用参数 / common ingress-nginx parameters",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
          "default": "ClusterIP",
          "description": "Service 类型：裸金属上通常用 NodePort 或配合 metallb 用 LoadBalancer / service type: NodePort or LoadBalancer (with metallb) on bare metal"
        }
      }
    }
  },
  "properties": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 1,
          "description": "控制器副本数 / number of controller replicas"
        },
        "service": { "$ref": "#/$defs/service" }
      }
    }
  }
}
